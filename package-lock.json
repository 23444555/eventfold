{
  "name": "eventfold-monorepo",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "eventfold-monorepo",
      "version": "0.2.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/dossier": {
      "resolved": "packages/dossier",
      "link": true
    },
    "node_modules/eventfold": {
      "resolved": "packages/eventfold",
      "link": true
    },
    "node_modules/fold-guard": {
      "resolved": "packages/fold-guard",
      "link": true
    },
    "packages/dossier": {
      "version": "0.2.0",
      "license": "MIT",
      "dependencies": {
        "fold-guard": "^0.2.0"
      },
      "bin": {
        "dossier": "src/index.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/eventfold": {
      "version": "0.2.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/fold-guard": {
      "version": "0.2.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
